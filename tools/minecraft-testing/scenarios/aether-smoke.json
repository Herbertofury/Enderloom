{
  "name": "Aether dimension and Gravitite Sword acceptance",
  "scope": "Requires a loaded creative world with commands enabled. Exercises dimension transitions, generated terrain, a mod block, a mod entity and a real client attack. Does not cover all dungeons, bosses, recipes, multiplayer or survival progression.",
  "steps": [
    { "command": "@automation on", "expect": "OK automation on" },
    { "command": "/seed", "expect": "Seed:", "timeoutSeconds": 20 },
    { "command": "/spark profiler start --thread *", "expect": "Profiler is now running", "timeoutSeconds": 20 },
    { "command": "/execute in minecraft:overworld run tp @s -83.5 90 184.5 0 20", "expect": "Teleported", "timeoutSeconds": 30 },
    { "command": "/data get entity @s Dimension", "expect": "minecraft:overworld" },
    { "waitSeconds": 30 },
    { "screenshot": "Overworld reference · same mod set" },
    { "command": "/execute in aether:the_aether run tp @s 0.5 146 0.5 0 25", "expect": "Teleported", "timeoutSeconds": 30 },
    { "command": "/data get entity @s Dimension", "expect": "aether:the_aether" },
    { "command": "/fill -4 145 -4 4 145 5 aether:holystone", "timeoutSeconds": 10 },
    { "command": "/kill @e[tag=enderloom_test]" },
    { "command": "/item replace entity @s hotbar.0 with aether:gravitite_sword", "expect": "Replaced" },
    { "command": "key 1" },
    { "command": "/data get entity @s SelectedItem", "expect": "aether:gravitite_sword" },
    { "command": "/summon aether:phyg 0.5 146 2.5 {NoAI:1b,Tags:[\"enderloom_test\"]}", "expect": "Summoned new Phyg" },
    { "command": "/data get entity @e[tag=enderloom_test,limit=1] Health", "expect": "10.0" },
    { "screenshot": "Gravitite Sword equipped · Phyg before attack" },
    { "command": "@attack", "expect": "OK attack target=ENTITY" },
    { "screenshot": "Gravitite Sword attack · visual result" },
    { "command": "/data get entity @e[tag=enderloom_test,limit=1] Health", "expect": "following entity data" },
    { "command": "/execute as @e[tag=enderloom_test,limit=1] unless entity @s[nbt={Health:10.0f}] run say ENDERLOOM_SWORD_DAMAGE_CONFIRMED", "expect": "ENDERLOOM_SWORD_DAMAGE_CONFIRMED" },
    { "command": "@move forward 1000", "expect": "OK move forward" },
    { "waitSeconds": 30 },
    { "command": "/gamemode spectator", "expect": "Spectator" },
    { "command": "/tp @s 150 150 150 45 30", "expect": "Teleported", "timeoutSeconds": 30 },
    { "waitSeconds": 30 },
    { "command": "/data get entity @s Dimension", "expect": "aether:the_aether" },
    { "screenshot": "Aether terrain traversal · new chunks" },
    { "command": "/spark tps", "expect": "TPS", "timeoutSeconds": 10 },
    { "command": "/spark profiler stop --save-to-file", "expect": ".sparkprofile", "timeoutSeconds": 30 },
    { "command": "/execute in minecraft:overworld run tp @s -83.5 65 184.5", "expect": "Teleported", "timeoutSeconds": 30 },
    { "command": "/data get entity @s Dimension", "expect": "minecraft:overworld" },
    { "command": "/gamemode creative", "expect": "Creative" },
    { "screenshot": "Returned safely to the Overworld" }
  ]
}
